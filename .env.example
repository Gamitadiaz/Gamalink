# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Resend (email) — RESEND_FROM_EMAIL must be a verified domain in resend.com/domains
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Solo servidor (NUNCA con NEXT_PUBLIC_). Supabase -> Project Settings -> API Keys -> service_role / secret.
# Se usa para invitar a los dueños de las empresas desde el panel de empresas.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
